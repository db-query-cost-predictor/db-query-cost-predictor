# Copy this file to .env (git-ignored) and replace every CHANGE_ME value.
# The repository never contains a real password. Passwords: letters and digits
# only, at least 16 characters (the scripts reject anything else).
# Unquoted values are taken literally (no escape processing), so Windows paths
# can be written as-is.

# --- Paths -----------------------------------------------------------------------
# Absolute path OUTSIDE the repository. Create it yourself (runbook step 3).
QCP_DATA_ROOT=C:\qcp_data
# Python interpreter used by the PowerShell scripts (relative to the repository
# root, or absolute if you created the virtual environment elsewhere).
QCP_PYTHON=.venv\Scripts\python.exe

# --- PostgreSQL image (PostgreSQL 16 only) ---------------------------------------
# The start script records the resolved image ID and digest. You may later pin
# postgres:16@sha256:<digest> by copying the digest from
# reports/poster/environment/postgres_image.json — never type one from memory.
QCP_POSTGRES_IMAGE=postgres:16

# --- Network: both databases are published on 127.0.0.1 only ------------------------
QCP_DB_HOST=127.0.0.1
QCP_BENCH_PORT=55432
QCP_EVIDENCE_PORT=55433

# --- Container resources (preflight checks them against Docker Desktop) ------------
QCP_BENCH_CPUS=2
QCP_BENCH_MEMORY=4g
QCP_BENCH_SHM_SIZE=1g
QCP_EVIDENCE_CPUS=1
QCP_EVIDENCE_MEMORY=1g

# --- Safety limit for the read-only benchmark role (temporary files per session) -----
QCP_READER_TEMP_FILE_LIMIT=5GB

# --- Container administrator accounts (used only by db-init and health checks) -------
QCP_BENCH_ADMIN_USER=qcp_admin
QCP_BENCH_ADMIN_PASSWORD=CHANGE_ME_BENCH_ADMIN
QCP_EVIDENCE_ADMIN_USER=qcp_admin
QCP_EVIDENCE_ADMIN_PASSWORD=CHANGE_ME_EVIDENCE_ADMIN

# --- Application roles created by db-init (role names are fixed in code) -------------
# qcp_bench_owner   owns the TPC-H databases (loading only)
# qcp_bench_reader  read-only role used for every measured query
# qcp_evidence_owner owns the evidence schema (migrations only)
# qcp_evidence_writer writes evidence rows (no DDL)
QCP_BENCH_OWNER_PASSWORD=CHANGE_ME_BENCH_OWNER
QCP_BENCH_READER_PASSWORD=CHANGE_ME_BENCH_READER
QCP_EVIDENCE_OWNER_PASSWORD=CHANGE_ME_EVIDENCE_OWNER
QCP_EVIDENCE_WRITER_PASSWORD=CHANGE_ME_EVIDENCE_WRITER

# --- TPC-H data generator (tools image build) -----------------------------------------
# Third-party copy of TPC dbgen, pinned to the commit the pilot used.
# Confirm the TPC license terms are acceptable before building.
QCP_TPCH_DBGEN_REPO=https://github.com/electrum/tpch-dbgen.git
QCP_TPCH_DBGEN_COMMIT=32f1c1b92d1664dba542e927d23d86ffa57aa253
